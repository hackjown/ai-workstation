# ---- API host ----
# web console: open http://host:8000/?token=...
AIW_API_TOKEN=change-me-long-random
# ai-linux-001 address on vmbr0
AIW_VM_IP=192.168.50.X
AIW_VM_ID=104
# must match the VM's ~/.config/aiw/vm-agent.env
VM_AGENT_TOKEN=change-me-too
# AIW_ALLOW_DOMAINS=google.com,openai.com    # optional: other domains need user confirmation (L3)

# ---- Proxmox (VM Runtime only; the agent never sees these) ----
PVE_HOST=https://192.168.50.200:8006
PVE_NODE=hackjown
PVE_TOKEN_ID=aiw@pve!runtime
PVE_TOKEN_SECRET=
PVE_VERIFY_TLS=false

# ---- LLM Router (first configured provider wins; falls back in order) ----
AIW_LLM_ORDER=anthropic,openai,google
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# OPENAI_BASE_URL=http://localhost:8001/v1   # any OpenAI-compatible endpoint (vLLM, Qwen-VL, ...)
GEMINI_API_KEY=
# AI 改图模型（image_edit 工具，走同一个网关），也可在网页 设置→模型→改图模型 里选
# AIW_IMAGE_MODEL=gpt-image-1
# AIW_GEOMETRY_MODEL=gemini-3.1-pro   # boxes things (0-1000) for exact moves like 加高到齐平; default: the vision model
# AIW_IMAGE_MODEL on the UniAPI gateway: qwen3.8-max-image-edit (an edit model), not qwen3.8-max-image

# noVNC 自动填入的 VNC 密码（与 104 上 setup-vm.sh 的 VNC_PASSWORD 相同），留空则网页弹窗手动输入
AIW_VNC_PASSWORD=

# ---- V1.1 ----
# 加密网页里保存的密钥（API Key、MCP token 等）。留空则自动生成 data/.secret_key
AIW_SECRET_KEY=
# 例程和追踪使用的时区
AIW_TZ=Asia/Shanghai
# API 重启时把 30 分钟内被中断的任务自动重新排队
AIW_RESUME_INTERRUPTED=true
# Agent 向你提问后最长等待秒数
AIW_ASK_TIMEOUT=600
# 一次性隔离电脑：从这个快照完整克隆 VM（需要 PVE token 有 VM.Clone/VM.Allocate/Datastore.AllocateSpace 权限）
AIW_CLONE_SNAPSHOT=clean
# 任务超时（秒）、模型输出上限、深度思考（off 更快）
AIW_TASK_TIMEOUT=900
AIW_LLM_MAX_TOKENS=4096
AIW_LLM_THINKING=off
# 推送深链（3.8）：点 Bark 通知打开 Aiw。默认 aiw://（需要装了 Aiw App）；没装 App 时设 AIW_PUSH_LINK=web，
# 用网页版打开 <AIW_PUBLIC_URL>/open/…（手机能访问到的地址，如 http://192.168.50.102:18000）。也可在 设置 › 通知 里改。
# AIW_PUBLIC_URL=http://192.168.50.102:18000
# AIW_PUSH_LINK=app

# 3.8.2 task budgets: a task never ends by itself; stuck = pause + push + card (继续 / 接管 / 停止), only 停止 ends it.
# AIW_TASK_MAX_STEPS=0          # 0 = no step limit (default); N = pause and ask after N steps
# AIW_TASK_TIMEOUT=0            # 0 = no time limit (default); N seconds = pause and ask when it runs low
# AIW_TASK_CHECKIN_STEPS=150    # soft valve: pause and ask after this many steps without visible progress (0 = off)
# AIW_SHOP_WAIT_BUSY=1          # price watch waits while its own computer runs a task (never borrows another one)

# v3.9.24 进阶功能（都在 设置 › 进阶功能 里配置；下面只是强制开关，详见 docs/v3.9.24.md）
# AIW_AUTOROUTE=            # 0 强制关闭 / 1 强制开启 自动模型路由
# AIW_AUTOREVIEW=           # 0 强制关闭 自动审核
# AIW_WEBHOOKS=1            # 0 关闭 POST /api/webhooks/{id}
# AIW_USAGE=1               # 0 不记录 token 用量
# AIW_APPS=1                # 0 关闭所有应用
# AIW_PROMPT_OVERRIDES=1    # 0 全部角色用原版提示词
# AIW_CONTEXT_MANAGE=1      # 0 关闭按模型的上下文压缩
# AIW_TEACH=1               # 0 关闭教学录制
# AIW_REMOTE_TUNNEL=1       # 0 禁用内置 cloudflared 隧道（需要 AIW_API_TOKEN 才能开）
# AIW_CLOUDFLARED_URL=      # cloudflared 下载镜像地址（默认 GitHub releases）
# AIW_LAN_IP=               # 远程访问页显示的局域网 IP（Docker 里看不到宿主机 IP）
# AIW_CHECKIN=1             # 0 停止定时自动签到
