[Unit]
Description=AI Workstation VM Agent
After=graphical-session.target

[Service]
EnvironmentFile=@HOME@/.config/aiw/vm-agent.env
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do xdpyinfo >/dev/null 2>&1 && exit 0; sleep 2; done; exit 1'
ExecStart=@HOME@/.aiw-venv/bin/python -m vm_agent.server.websocket --host 0.0.0.0 --port 8765
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
